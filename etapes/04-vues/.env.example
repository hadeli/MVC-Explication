# Copier ce fichier vers .env et adapter les valeurs à votre machine.
# .env n'est jamais versionné.

# DSN PDO. Pour SQLite, un chemin relatif est résolu depuis la racine du projet.
DB_DSN=sqlite:database.sqlite
# Inutilisés avec SQLite, nécessaires pour MySQL : DB_DSN="mysql:host=127.0.0.1;dbname=mvc;charset=utf8mb4"
DB_USER=
DB_PASSWORD=
